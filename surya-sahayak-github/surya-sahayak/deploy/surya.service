[Unit]
Description=Surya Sahayak API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/surya-sahayak
EnvironmentFile=-/home/ubuntu/surya-sahayak/.env
ExecStart=/home/ubuntu/surya-sahayak/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
